.quiz-app {
  min-height: 100dvh;
  background: #080808;
  color: #f5f2ee;
  font-family: 'DM Sans', sans-serif;
  cursor: auto;
}

.quiz-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px clamp(16px, 4vw, 40px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
