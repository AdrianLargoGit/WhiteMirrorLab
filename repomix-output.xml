<file path="src/app/web/wml.css">
/* WML 1.0 app styles */
:root {
  --w-bg: #080808;
  --w-surface: #111111;
  --w-border: rgba(255, 255, 255, 0.08);
  --w-text: #f5f2ee;
  --w-muted: #6a6a6a;
  --w-accent: #c8ff00;
  --w-positive: #4ade80;
  --w-negative: #f87171;
  --w-font: 'DM Sans', sans-serif;
  --w-mono: 'Space Mono', monospace;
}

.wml-app {
  min-height: 100dvh;
  background: var(--w-bg);
  color: var(--w-text);
  font-family: var(--w-font);
  padding-bottom: 72px;
  cursor: auto;
}

/* Restore normal cursor (overrides landing custom cursor on body) */
.wml-app,
.wml-app * {
  cursor: auto;
}

.wml-app a,
.wml-app button,
.wml-app label,
.wml-app .wml-upload-label,
.wml-app [role='button'] {
  cursor: pointer;
}

.wml-app button:disabled {
  cursor: not-allowed;
}

.wml-nav {
  position: sticky;
  top: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 20px;
  background: rgba(8, 8, 8, 0.92);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--w-border);
}

.wml-nav-left {
  display: flex;
  align-items: center;
  gap: 10px;
}

.wml-nav-logout {
  background: none;
  border: none;
  font: inherit;
}

.wml-nav-logo {
  font-family: var(--w-mono);
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 8px;
  text-decoration: none;
  color: var(--w-text);
}

.wml-nav-logo-dot {
  width: 7px;
  height: 7px;
  background: var(--w-accent);
  border-radius: 50%;
}

.wml-nav-links {
  display: flex;
  gap: 4px;
}

.wml-nav-link {
  font-family: var(--w-mono);
  font-size: 10px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--w-muted);
  text-decoration: none;
  padding: 8px 12px;
  border-radius: 4px;
  transition: color 0.15s, background 0.15s;
}

.wml-nav-link:hover,
.wml-nav-link.active {
  color: var(--w-text);
  background: var(--w-surface);
}

.wml-main {
  max-width: 640px;
  margin: 0 auto;
  padding: 20px;
}

.wml-section-title {
  font-family: var(--w-mono);
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--w-muted);
  margin-bottom: 14px;
}

/* Auth */
.wml-auth {
  min-height: 100dvh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: var(--w-bg);
}

.wml-auth-card {
  width: 100%;
  max-width: 380px;
  background: var(--w-surface);
  border: 1px solid var(--w-border);
  padding: 32px 28px;
  border-radius: 2px;
}

.wml-auth-logo {
  font-family: var(--w-mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 24px;
  color: var(--w-muted);
}

.wml-auth-title {
  font-size: 22px;
  font-weight: 600;
  margin-bottom: 6px;
}

.wml-auth-sub {
  font-size: 14px;
  color: var(--w-muted);
  margin-bottom: 24px;
}

.wml-input {
  width: 100%;
  background: var(--w-bg);
  border: 1px solid var(--w-border);
  color: var(--w-text);
  padding: 12px 14px;
  font-size: 14px;
  font-family: var(--w-font);
  margin-bottom: 10px;
  border-radius: 2px;
  outline: none;
  transition: border-color 0.15s;
}

.wml-input:focus {
  border-color: var(--w-accent);
}

.wml-btn {
  font-family: var(--w-mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 12px 20px;
  border: none;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border-radius: 2px;
  transition: opacity 0.15s;
}

.wml-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.wml-btn-primary {
  background: var(--w-accent);
  color: var(--w-bg);
}

.wml-btn-ghost {
  background: transparent;
  color: var(--w-muted);
  border: 1px solid var(--w-border);
}

.wml-auth-switch {
  margin-top: 20px;
  font-size: 13px;
  color: var(--w-muted);
  text-align: center;
}

.wml-auth-switch button {
  background: none;
  border: none;
  color: var(--w-accent);
  cursor: pointer;
  font-size: 13px;
  text-decoration: underline;
}

.wml-error-msg {
  background: rgba(248, 113, 113, 0.1);
  border: 1px solid rgba(248, 113, 113, 0.3);
  color: var(--w-negative);
  padding: 10px 14px;
  font-size: 13px;
  margin-bottom: 14px;
  border-radius: 2px;
}

.wml-success-msg {
  background: rgba(74, 222, 128, 0.1);
  border: 1px solid rgba(74, 222, 128, 0.3);
  color: var(--w-positive);
  padding: 10px 14px;
  font-size: 13px;
  margin-bottom: 14px;
  border-radius: 2px;
}

/* Stories */
.wml-stories {
  display: flex;
  gap: 14px;
  overflow-x: auto;
  padding-bottom: 8px;
  margin-bottom: 28px;
  scrollbar-width: none;
}

.wml-stories::-webkit-scrollbar {
  display: none;
}

.wml-story-item {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  background: none;
  border: none;
  color: var(--w-text);
  font-family: var(--w-font);
  font-size: 11px;
}

.wml-story-ring {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  padding: 2px;
  background: linear-gradient(135deg, var(--w-accent), #888);
}

.wml-story-ring img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid var(--w-bg);
}

.wml-story-add {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  border: 1px dashed var(--w-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  color: var(--w-muted);
}

/* User card */
.wml-card {
  background: var(--w-surface);
  border: 1px solid var(--w-border);
  padding: 18px;
  margin-bottom: 12px;
  border-radius: 2px;
}

.wml-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.wml-card-user {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  color: var(--w-text);
}

.wml-card-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--w-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--w-mono);
  font-size: 14px;
  color: var(--w-accent);
  overflow: hidden;
}

.wml-card-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.wml-card-name {
  font-weight: 600;
  font-size: 15px;
}

.wml-card-username {
  font-family: var(--w-mono);
  font-size: 11px;
  color: var(--w-muted);
}

.wml-karma {
  font-family: var(--w-mono);
  font-size: 18px;
  font-weight: 700;
}

.wml-karma.positive { color: var(--w-positive); }
.wml-karma.negative { color: var(--w-negative); }
.wml-karma.neutral { color: var(--w-muted); }

.wml-vote-stats {
  display: flex;
  gap: 16px;
  font-family: var(--w-mono);
  font-size: 11px;
  color: var(--w-muted);
  margin-bottom: 12px;
}

.wml-vote-stats span.pos { color: var(--w-positive); }
.wml-vote-stats span.neg { color: var(--w-negative); }

.wml-vote-btns {
  display: flex;
  gap: 8px;
}

.wml-vote-btn {
  flex: 1;
  padding: 10px;
  border: 1px solid var(--w-border);
  background: transparent;
  color: var(--w-muted);
  font-family: var(--w-mono);
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  cursor: pointer;
  border-radius: 2px;
  transition: all 0.15s;
}

.wml-vote-btn:hover {
  border-color: var(--w-text);
  color: var(--w-text);
}

.wml-vote-btn.active-pos {
  background: rgba(74, 222, 128, 0.15);
  border-color: var(--w-positive);
  color: var(--w-positive);
}

.wml-vote-btn.active-neg {
  background: rgba(248, 113, 113, 0.15);
  border-color: var(--w-negative);
  color: var(--w-negative);
}

/* Photos */
.wml-photos {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4px;
  margin-bottom: 16px;
}

.wml-photo {
  aspect-ratio: 1;
  background: var(--w-bg);
  overflow: hidden;
}

.wml-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Search */
.wml-search-input {
  width: 100%;
  background: var(--w-surface);
  border: 1px solid var(--w-border);
  color: var(--w-text);
  padding: 14px 16px;
  font-size: 15px;
  font-family: var(--w-font);
  margin-bottom: 20px;
  border-radius: 2px;
  outline: none;
}

.wml-search-input:focus {
  border-color: var(--w-accent);
}

/* Ranking */
.wml-rank-item {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px 0;
  border-bottom: 1px solid var(--w-border);
  text-decoration: none;
  color: var(--w-text);
}

.wml-rank-pos {
  font-family: var(--w-mono);
  font-size: 14px;
  color: var(--w-muted);
  width: 28px;
  text-align: right;
}

.wml-rank-pos.top {
  color: var(--w-accent);
  font-weight: 700;
}

/* Story viewer modal */
.wml-modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.95);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wml-modal-close {
  position: absolute;
  top: 20px;
  right: 20px;
  background: none;
  border: none;
  color: var(--w-text);
  font-size: 28px;
  cursor: pointer;
  z-index: 101;
}

.wml-story-viewer img {
  max-width: 100vw;
  max-height: 90dvh;
  object-fit: contain;
}

.wml-story-viewer-meta {
  position: absolute;
  bottom: 24px;
  left: 20px;
  font-family: var(--w-mono);
  font-size: 12px;
}

.wml-upload-label {
  display: inline-block;
  cursor: pointer;
}

.wml-upload-label input {
  display: none;
}

.wml-empty {
  text-align: center;
  color: var(--w-muted);
  padding: 40px 20px;
  font-size: 14px;
}

.wml-bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: rgba(8, 8, 8, 0.95);
  backdrop-filter: blur(12px);
  border-top: 1px solid var(--w-border);
  z-index: 50;
}

.wml-bottom-nav a {
  flex: 1;
  text-align: center;
  padding: 14px 8px;
  font-family: var(--w-mono);
  font-size: 9px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--w-muted);
  text-decoration: none;
  transition: color 0.15s;
}

.wml-bottom-nav a.active,
.wml-bottom-nav a:hover {
  color: var(--w-accent);
}

.wml-bottom-back {
  flex: 0 0 48px !important;
  font-size: 16px !important;
  letter-spacing: 0 !important;
}

@media (min-width: 768px) {
  .wml-bottom-nav {
    display: none;
  }
}

/* Back bar (consent, auth) */
.wml-back-bar {
