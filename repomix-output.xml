  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #6a6a6a;
  text-decoration: none;
}

.quiz-back:hover {
  color: #f5f2ee;
}

.quiz-brand {
  font-family: 'Space Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #c8ff00;
}

.quiz-main {
  max-width: 560px;
  margin: 0 auto;
  padding: 32px clamp(16px, 4vw, 24px) 64px;
}

.quiz-label {
  font-family: 'Space Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #6a6a6a;
  margin-bottom: 12px;
}

.quiz-title {
  font-size: clamp(22px, 4vw, 28px);
  font-weight: 700;
  margin-bottom: 8px;
  letter-spacing: -0.02em;
}

.quiz-desc {
  color: #6a6a6a;
  font-size: 15px;
  line-height: 1.6;
  margin-bottom: 32px;
}

.quiz-card {
  background: #111;
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 20px;
  margin-bottom: 16px;
  border-radius: 2px;
}

.quiz-q {
  font-size: 15px;
  font-weight: 500;
  margin-bottom: 14px;
  line-height: 1.45;
}

.quiz-opt {
  display: block;
  width: 100%;
  text-align: left;
  padding: 12px 14px;
  margin-bottom: 8px;
  background: #080808;
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: #c8c4be;
  font-family: 'DM Sans', sans-serif;
  font-size: 14px;
