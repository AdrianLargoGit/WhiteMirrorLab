              {p.karma_score > 0 ? '+' : ''}{p.karma_score}
            </div>
            <div style={{ fontFamily: 'var(--w-mono)', fontSize: 10, color: 'var(--w-muted)', marginTop: 4 }}>
              +{p.votes_received_positive} / -{p.votes_received_negative}
            </div>
          </div>
        </Link>
      ))}
    </div>
  )
}
